generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  orderIndex  Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  composition      String?          // Skład, np. 70% wiskoza, 30% jedwab
  careGuide        String?          // Zasady pielęgnacji
  sizeGuide        String?          // Tabela wymiarów / instrukcja
  basePrice          Decimal          @db.Decimal(10, 2)
  promotionalPrice   Decimal?         @db.Decimal(10, 2)
  promotionStartedAt DateTime?        // Data i godzina uruchomienia danej promocji
  lowestPrice30Days  Decimal?         @db.Decimal(10, 2) // Cena referencyjna dyrektywy Omnibus (najniższa z 30 dni)
  isPromoted         Boolean          @default(false) // Dedykowana rubryka na zaznaczanie produktów w promocji
  isNew              Boolean          @default(false) // Oznaczenie: Nowość
  isBestseller       Boolean          @default(false) // Oznaczenie: Bestseller
  isPublished        Boolean          @default(true)  // Widoczny w sklepie
  isArchived         Boolean          @default(false) // Zarchiwizowany
  isDemo             Boolean          @default(false) // Oznaczenie danych demonstracyjnych
  purchasePrice      Decimal?         @db.Decimal(10, 2) // Prywatny koszt zakupu za sztukę
  extraUnitCost      Decimal?         @db.Decimal(10, 2) // Dodatkowy koszt jednostkowy (np. transport z hurtowni)
  costEffectiveDate  DateTime?        // Data obowiązywania kosztu zakupu
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  variants           ProductVariant[]
  priceHistory       PriceHistory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([categoryId])
  @@index([isPublished, isArchived])
  @@index([isPromoted])
  @@index([isNew])
  @@index([isBestseller])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  orderIndex Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size              String         // np. XS, S, M, L, XL, UNI
  color             String         // np. Piaskowy beż, Pudrowy róż, Głęboka czerń
  colorHex          String?        // Kod koloru HEX do próbnika
  sku               String         @unique
  stockQuantity     Int            @default(0) // Dostępny stan magazynowy
  reservedQuantity  Int            @default(0) // Tymczasowo zarezerwowane dla koszyków/zamówień
  price             Decimal?       @db.Decimal(10, 2) // Opcjonalna indywidualna cena wariantu
  promotionalPrice  Decimal?       @db.Decimal(10, 2)
  lowestPrice30Days Decimal?       @db.Decimal(10, 2)
  purchasePrice     Decimal?       @db.Decimal(10, 2) // Indywidualna cena zakupu wariantu
  extraUnitCost     Decimal?       @db.Decimal(10, 2) // Dodatkowy koszt jednostkowy wariantu
  costEffectiveDate DateTime?      // Data obowiązywania kosztu wariantu
  priceHistory      PriceHistory[]
  orderItems        OrderItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([productId])
  @@unique([productId, size, color])
}

model PriceHistory {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal         @db.Decimal(10, 2)
  isPromotion Boolean         @default(false)
  changedAt   DateTime        @default(now())

  @@index([productId, changedAt])
  @@index([variantId, changedAt])
}

enum ShippingMethod {
  INPOST_LOCKER
  COURIER
  LOCAL_PICKUP
}

enum PaymentMethod {
  PRZELEWY24
  BLIK
  TRADITIONAL_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique // np. AURA-2026-0001
  isTest             Boolean           @default(false) // Flaga zamówienia testowego sandbox
  customerFirstName  String
  customerLastName   String
  customerEmail      String
  customerPhone      String
  shippingMethod     ShippingMethod    @default(INPOST_LOCKER)
  parcelLockerCode   String?           // Kod paczkomatu InPost
  shippingStreet     String?
  shippingCity       String?
  shippingPostalCode String?
  paymentMethod      PaymentMethod     @default(BLIK)
  paymentStatus      PaymentStatus     @default(PENDING)
  paidAt             DateTime?         // Data ostatecznego potwierdzenia płatności
  paidAmount         Decimal?          @db.Decimal(10, 2) // Łączna potwierdzona kwota wpłat
  remainingAmount    Decimal?          @db.Decimal(10, 2) // Pozostała kwota do dopłaty
  accessKey          String?           // Klucz dostępu dla gościa (autoryzacja podglądu zamówienia)
  fulfillmentStatus  FulfillmentStatus @default(NEW)
  trackingNumber     String?           // Numer listu przewozowego
  subtotalAmount     Decimal           @db.Decimal(10, 2)
  shippingCost       Decimal           @db.Decimal(10, 2)
  totalAmount        Decimal           @db.Decimal(10, 2)
  couponCode         String?           // Kod rabatowy użyty w zamówieniu
  customerNotes      String?
  adminNotes         String?
  reservedUntil      DateTime?         // Czas wygaśnięcia rezerwacji towaru
  customerId         String?
  customer           CustomerAccount?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  wantsInvoice       Boolean           @default(false)
  invoiceType        String?           // "COMPANY" | "PRIVATE"
  invoiceCompanyName String?
  invoiceNip         String?
  invoiceStreet      String?
  invoiceCity        String?
  invoicePostalCode  String?
  invoicePdfUrl      String?
  invoiceNumber      String?
  invoiceIssuedAt    DateTime?
  customOrderCosts   String?           @db.Text // Pozycje kosztowe zamówienia (opakowanie, prowizje, gratisy, itp.) w JSON
  items              OrderItem[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot String          // Nazwa produktu z chwili zakupu
  variantSnapshot     String          // Rozmiar, Kolor, SKU z chwili zakupu
  unitPriceSnapshot   Decimal         @db.Decimal(10, 2)
  unitPurchasePriceSnapshot Decimal?  @db.Decimal(10, 2) // Koszt zakupu jednostkowy z chwili sprzedaży
  unitExtraCostSnapshot     Decimal?  @db.Decimal(10, 2) // Koszt dodatkowy jednostkowy z chwili sprzedaży
  quantity            Int             @default(1)
  totalSnapshot       Decimal         @db.Decimal(10, 2)
  productImageUrl     String?

  @@index([orderId])
  @@index([variantId])
}

model StoreSettings {
  id                    String    @id @default("default")
  boutiqueName          String    @default("AURA Boutique K.B.")
  companyName           String?
  nip                   String?
  regon                 String?
  registeredAddress     String?
  returnAddress         String?
  address               String    @default("Żmigród | ul. Poprzeczna 3/1A")
  phone                 String    @default("+48 600 000 000")
  email                 String    @default("kontakt@auraboutique.pl")
  openingHours          String    @default("Pon - Pt: 10:00 - 18:00 | Sob: 10:00 - 14:00")
  announcementBarText   String    @default("Darmowa dostawa od 300 PLN | Odbiór osobisty w Żmigrodzie")
  heroHeadline          String    @default("Elegancja w każdym detalu")
  heroSubheadline       String    @default("Odkryj kolekcję stworzoną dla kobiet ceniących klasę, subtelność i najwyższą jakość kroju.")
  heroImageUrl          String?
  freeShippingFrom      Decimal   @default(300.00) @db.Decimal(10, 2)
  courierCost           Decimal   @default(15.00) @db.Decimal(10, 2)
  inpostLockerCost      Decimal   @default(13.00) @db.Decimal(10, 2)
  localPickupCost       Decimal   @default(0.00) @db.Decimal(10, 2)
  p24MerchantId         String?
  p24PosId              String?
  p24CrcKey             String?
  p24ApiKey             String?
  p24Sandbox            Boolean   @default(true)
  termsAndConditions    String?   @db.Text
  privacyPolicy         String?   @db.Text
  visualBannerDraft     String?   @db.Text
  visualBannerPublished String?   @db.Text
  bannerVersion         Int       @default(1)
  bannerPublishedAt     DateTime?
  // SMTP & Email configuration
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPassword          String?   @db.Text
  smtpSecure            Boolean   @default(false)
  emailSenderName       String?
  emailSenderAddress    String?
  emailProvider         String?   @default("smtp") // "smtp" | "resend"
  resendApiKey          String?
  // PayU configuration
  payuPosId             String?
  payuSecondKey         String?
  payuClientId          String?
  payuClientSecret      String?
  payuSandbox           Boolean   @default(true)
  costCalculatorSettings String?  @db.Text // JSON z konfiguracją modułu Koszty i kalkulator marży
  updatedAt             DateTime  @updatedAt
}

model EmailOutbox {
  id        String    @id @default(cuid())
  recipient String
  subject   String
  type      String    // "ORDER_CONFIRMATION" | "STATUS_UPDATE" | "INVOICE" | "TEST"
  status    String    // "QUEUED" | "SENT" | "FAILED"
  error     String?   @db.Text
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  orderId   String?
  metadata  String?   @db.Text

  @@index([recipient])
  @@index([orderId])
  @@index([createdAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdminAccount {
  id                    String    @id @default("default")
  email                 String    @unique @default("aurazmigrod@wp.pl")
  passwordHash          String?   @db.Text
  mustChangePassword    Boolean   @default(true)
  lastPasswordChangedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   @db.Text
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CustomerAccount {
  id                     String               @id @default(cuid())
  email                  String               @unique
  firstName              String
  lastName               String
  phone                  String?
  passwordHash           String?
  googleId               String?              @unique
  emailVerified          Boolean              @default(false)
  emailVerificationToken String?              // skrót SHA-256 tokenu weryfikacyjnego
  verificationExpiresAt  DateTime?
  resendCooldownUntil    DateTime?
  resendAttemptsCount    Int                  @default(0)
  welcomeDiscountCode    String?              @unique
  welcomeDiscountUsed    Boolean              @default(false)
  welcomeDiscountUsedAt  DateTime?
  welcomeDiscountUsedInOrderId String?
  referralCode           String?              @unique
  defaultStreet          String?
  defaultCity            String?
  defaultPostalCode      String?
  lastParcelLocker       String?
  lastParcelLockerAddress String?
  invoiceType            String?
  invoiceCompanyName     String?
  invoiceNip             String?
  invoiceStreet          String?
  invoiceCity            String?
  invoicePostalCode      String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  referralParticipant    ReferralParticipant?
  orders                 Order[]
}

model ReferralParticipant {
  id                  String              @id @default(cuid())
  customerId          String?             @unique
  customer            CustomerAccount?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email               String              @unique
  customerName        String
  referralCode        String              @unique
  totalReferralsCount Int                 @default(0)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  rewardCodes         ReferralRewardCode[]
}

model ReferralRewardCode {
  id              String               @id @default(cuid())
  participantId   String?
  participant     ReferralParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  code            String               @unique
  referrerEmail   String
  referredEmail   String
  referredOrderId String               @unique
  discountPercent Decimal              @default(15.00) @db.Decimal(5, 2)
  validUntil      DateTime
  isUsed          Boolean              @default(false)
  usedAt          DateTime?
  usedInOrderId   String?
  isRevoked       Boolean              @default(false)
  revokedReason   String?
  adminFlagged    Boolean              @default(false)
  createdAt       DateTime             @default(now())
}

model NewsletterSubscription {
  id                String    @id @default(cuid())
  email             String    @unique
  status            String    @default("PENDING") // PENDING, CONFIRMED, UNSUBSCRIBED
  source            String    // REGISTER, CHECKOUT, ACCOUNT, FOOTER
  consentText       String
  consentVersion    String    @default("1.0")
  confirmationToken String?   @unique
  unsubscribeToken  String    @unique @default(cuid())
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customerId        String?
}

model OwnerNote {
  id          String    @id @default(cuid())
  title       String
  content     String
  isPinned    Boolean   @default(false)
  isCompleted Boolean   @default(false)
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CalendarEvent {
  id             String    @id @default(cuid())
  title          String
  description    String?
  eventDate      String    // Format YYYY-MM-DD
  eventTime      String?   // Format HH:MM
  category       String    // TAXES, DELIVERIES, BOUTIQUE, OTHER
  priority       String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isCompleted    Boolean   @default(false)
  recurrenceRule String?   // NONE, WEEKLY, MONTHLY, YEARLY
  recurringId    String?
  isException    Boolean   @default(false)
  completedDates String?   // JSON tablica ukończonych dat wystąpień
  reminderDays   Int?      // 0, 1, 3
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model IndividualDiscount {
  id               String    @id @default(cuid())
  code             String    @unique
  customerId       String?
  customerEmail    String
  discountPercent  Decimal   @db.Decimal(5, 2)
  isPermanent      Boolean   @default(false) // false = jednorazowy, true = stały
  validUntil       DateTime? // dla jednorazowego
  minCartValue     Decimal?  @db.Decimal(10, 2)
  canCombine       Boolean   @default(false)
  adminNote        String?
  grantedBy        String    @default("Właścicielka")
  isUsed           Boolean   @default(false)
  usedAt           DateTime?
  usedInOrderId    String?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokedReason    String?
  emailSentAt      DateTime?
  emailSendStatus  String?
  emailSendError   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerEmail])
  @@index([customerId])
  @@index([code])
}
