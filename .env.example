# ========================================================
# AURA Boutique K.B. - Środowiskowe Zmienne Konfiguracyjne
# Skopiuj ten plik do .env i uzupełnij swoimi danymi.
# ========================================================

# 1. Połączenie z bazą Neon PostgreSQL (Server-side only)
# Pobierz URL połączenia z Neon Console (Connection details -> Pooled connection)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. Bezpieczeństwo panelu administracyjnego (/admin)
# Hasło właścicielki butiku do logowania w panelu /admin
ADMIN_PASSWORD="ZmienToBezpieczneHasloAura2026!"
# Tajny klucz do podpisywania sesji administracyjnych (dowolny długi ciąg znaków)
ADMIN_SECRET_KEY="super-sekretny-klucz-sesji-butiku-aura-kb-min-32-znaki"

# 3. Magazyn zdjęć (Cloudinary lub Vercel Blob)
# Jeśli korzystasz z Cloudinary:
CLOUDINARY_CLOUD_NAME="twoja_nazwa_chmury"
CLOUDINARY_API_KEY="twoj_api_key"
CLOUDINARY_API_SECRET="twoj_api_secret"

# 4. Przelewy24 / BLIK (Opcjonalne - aktywowane w panelu lub po uzgodnieniu)
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_CRC_KEY=""
P24_API_KEY=""
P24_IS_SANDBOX="true"

# 5. Adres URL aplikacji (produkcja / dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
